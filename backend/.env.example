# -----------------------------------------------------------------------------
# TalentFlow Backend — Environment Variables
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values for your environment.
# NEVER commit a real `.env` file — it is gitignored.
#
# The backend validates these at startup via `src/config/env.ts` (Zod).
# Missing/invalid values fail fast before the server boots.
# -----------------------------------------------------------------------------

# Runtime environment: development | test | production
NODE_ENV=development

# Port the Express server listens on.
# On Render (and most PaaS hosts) the platform injects PORT automatically —
# leave it unset there and the app will bind to the provided port.
PORT=4000

# -----------------------------------------------------------------------------
# CORS / allowed origins
# -----------------------------------------------------------------------------
# Comma-separated list of allowed browser origins (your frontend URL(s)).
# This is the value the backend actually reads (see `corsOrigins` in env.ts).
CORS_ORIGIN=http://localhost:5173
# Production example (Vercel frontend):
# CORS_ORIGIN=https://talentflow.vercel.app

# FRONTEND_URL — deployment convention only.
# The backend does NOT currently read a separate FRONTEND_URL variable; it uses
# CORS_ORIGIN above. If your host/runbook sets FRONTEND_URL, mirror the same
# value into CORS_ORIGIN so the browser origin is allow-listed.
# FRONTEND_URL=https://talentflow.vercel.app

# -----------------------------------------------------------------------------
# Database (PostgreSQL / Prisma)
# -----------------------------------------------------------------------------
# Local development (Postgres running on host):
DATABASE_URL="postgresql://talentflow:talentflow@localhost:5432/talentflow?schema=public"
# Docker Compose (service hostname `postgres`):
# DATABASE_URL="postgresql://talentflow:talentflow@postgres:5432/talentflow?schema=public"
# Production example (Neon — note sslmode=require and the pooled host):
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/talentflow?sslmode=require"

# -----------------------------------------------------------------------------
# Redis (optional — client is provisioned but not required to boot)
# -----------------------------------------------------------------------------
# Local development:
REDIS_URL="redis://localhost:6379"
# Docker Compose:
# REDIS_URL="redis://redis:6379"
# Production example (Upstash — uses the TLS `rediss://` scheme):
# REDIS_URL="rediss://default:PASSWORD@xxxx.upstash.io:6379"

# -----------------------------------------------------------------------------
# Authentication (JWT)
# -----------------------------------------------------------------------------
# Signing secret for JSON Web Tokens. MUST be at least 16 characters (enforced).
# Generate a strong secret, e.g. `openssl rand -hex 32`.
JWT_SECRET="replace-with-a-long-random-secret"
# Access-token lifetime (any `jsonwebtoken` expiresIn value: 1d, 12h, 3600, ...).
JWT_EXPIRES_IN=1d

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
# Global limiter — applied coarsely to every request.
RATE_LIMIT_WINDOW_MS=900000     # 15 minutes (in ms)
RATE_LIMIT_MAX=100              # max requests per window per client

# Stricter limiter — applied only to auth endpoints (login/register) to slow
# credential brute-force and account-enumeration attempts.
AUTH_RATE_LIMIT_WINDOW_MS=900000  # 15 minutes (in ms)
AUTH_RATE_LIMIT_MAX=10            # max auth attempts per window per client
