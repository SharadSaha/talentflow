# -----------------------------------------------------------------------------
# TalentFlow Backend — Environment Variables
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values for your environment.
# NEVER commit a real `.env` file — it is gitignored.
# -----------------------------------------------------------------------------

# Runtime environment: development | test | production
NODE_ENV=development

# Port the Express server listens on.
PORT=4000

# Comma-separated list of allowed CORS origins (the frontend URL(s)).
CORS_ORIGIN=http://localhost:5173

# --- Database (PostgreSQL / Prisma) ------------------------------------------
# Local development (Postgres running on host):
DATABASE_URL="postgresql://talentflow:talentflow@localhost:5432/talentflow?schema=public"
# When running via Docker Compose, use the service hostname `postgres`:
# DATABASE_URL="postgresql://talentflow:talentflow@postgres:5432/talentflow?schema=public"

# --- Redis -------------------------------------------------------------------
# Local development:
REDIS_URL="redis://localhost:6379"
# Docker Compose:
# REDIS_URL="redis://redis:6379"

# --- Authentication (implemented later) --------------------------------------
# Generate a strong secret, e.g. `openssl rand -hex 32`
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN=1d

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
