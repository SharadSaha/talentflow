# -----------------------------------------------------------------------------
# TalentFlow — Docker Compose overrides (OPTIONAL)
# -----------------------------------------------------------------------------
# docker-compose.yml has sensible defaults for everything, so this file is
# NOT required to run `docker compose up --build`.
#
# Copy to `.env` (in the repo root) only if you want to override defaults.
# The root `.env` is gitignored — never commit real secrets.
# -----------------------------------------------------------------------------

# --- Postgres ---
POSTGRES_USER=talentflow
POSTGRES_PASSWORD=talentflow
POSTGRES_DB=talentflow
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Backend ---
NODE_ENV=production
BACKEND_PORT=4000
CORS_ORIGIN=http://localhost:8080
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d

# --- Frontend ---
FRONTEND_PORT=8080
VITE_API_BASE_URL=http://localhost:4000/api
VITE_APP_NAME=TalentFlow
