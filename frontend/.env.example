# -----------------------------------------------------------------------------
# TalentFlow Frontend — Environment Variables
# -----------------------------------------------------------------------------
# Copy this file to `.env` and adjust values as needed.
# Only variables prefixed with VITE_ are exposed to the client bundle.
# NEVER put secrets (API keys, DB passwords, JWT secrets) in this file.
# -----------------------------------------------------------------------------

# Base URL of the backend API.
# Local development (backend running on host):
VITE_API_BASE_URL=http://localhost:4000/api
# When running via Docker Compose, the browser still talks to the host-exposed
# port, so http://localhost:4000/api is correct there too.

# Application display name (optional).
VITE_APP_NAME=TalentFlow
