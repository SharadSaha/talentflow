# -----------------------------------------------------------------------------
# TalentFlow Frontend — Environment Variables
# -----------------------------------------------------------------------------
# Copy this file to `.env` and adjust values as needed.
# Only variables prefixed with VITE_ are exposed to the client bundle.
# NEVER put secrets (API keys, DB passwords, JWT secrets) in this file.
# Read these exclusively through src/config/env.ts — never hardcode them.
# -----------------------------------------------------------------------------

# Base URL of the backend API, including the version prefix (`/api/v1`).
#
# Local development (backend on the host, or via Docker Compose — the browser
# talks to the host-exposed port either way):
VITE_API_BASE_URL=http://localhost:4000/api/v1
#
# Production (e.g. the backend deployed on Render): point this at the deployed
# API origin instead, for example:
# VITE_API_BASE_URL=https://talentflow-api.onrender.com/api/v1

# Application display name (optional; defaults to "TalentFlow").
VITE_APP_NAME=TalentFlow
